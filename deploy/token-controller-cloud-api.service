# Ubuntu 24.04 template. Replace the example origin before installation.
# Install reviewed source and its locked .venv in /opt/token-controller first.
[Unit]
Description=Token Controller restricted cloud text pilot
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=token-controller
Group=token-controller
WorkingDirectory=/opt/token-controller
ExecStart=/opt/token-controller/.venv/bin/python -m gateway serve --state /var/lib/token-controller --port 18765 --cloud-api --upstream-config /etc/token-controller-api/upstream.json --public-origin https://models.example.test
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=TOKENIZERS_PARALLELISM=false
StateDirectory=token-controller
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# This preview cannot contact remote model providers. Keep the allowlist closed.
# The application additionally binds only 127.0.0.1; verify this after startup.
IPAddressDeny=any
IPAddressAllow=localhost
ReadWritePaths=/var/lib/token-controller
CPUQuota=100%
MemoryHigh=768M
MemoryMax=1G
TasksMax=128
LimitNOFILE=4096
StandardOutput=journal
StandardError=journal
SyslogIdentifier=token-controller

[Install]
WantedBy=multi-user.target
